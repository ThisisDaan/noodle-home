# Copied to .env by install.sh. install.sh fills in TZ and ZIGBEE_DEVICE when it can.
TZ=Europe/Amsterdam

# How phones reach the Noodle hub (used for buttons in phone notifications), e.g. http://192.168.1.10. Optional: it can
# also be set in the app under Connect > This hub.
#HOMEPI_URL=

# Path of your Zigbee stick on the Pi. Find it with: ls /dev/serial/by-id/
ZIGBEE_DEVICE=/dev/ttyUSB0

# Path of the Thread stick (MG24 with OpenThread RCP firmware), also from /dev/serial/by-id/.
THREAD_DEVICE=/dev/ttyUSB1
# Network interface the Pi uses for your LAN: eth0 (cable) or wlan0 (Wi-Fi).
THREAD_BACKBONE_IF=eth0

# ntfy topic for homepi's phone notifications (ntfy.sh). Use a long random name: it is the secret.
NTFY_TOPIC=

# Only needed for the optional UniFi controller (--profile unifi).
# install.sh replaces these with random values when they are still "change-me".
UNIFI_DB_ROOT_PASSWORD=change-me
UNIFI_DB_PASSWORD=change-me
